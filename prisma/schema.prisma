generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  // Reklam ölçümü ve kaynak takibi (20260915120000_lead_attribution)
  project     String?
  unitType    String?
  form        String?
  source      String?
  campaign    String?
  pageUrl     String?
  eventId     String?
  attribution Json?
  createdAt   DateTime @default(now())
}
