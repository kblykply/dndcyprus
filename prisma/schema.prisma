generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  // Reklam ölçümü ve kaynak takibi (20260915120000_lead_attribution)
  project     String?
  unitType    String?
  form        String?
  source      String?
  campaign    String?
  pageUrl     String?
  eventId     String?
  attribution Json?
  // Satış takibi (20261125180000_lead_status_notes): yeni | arandi | gorusuluyor | satis | olumsuz
  status      String     @default("yeni")
  statusAt    DateTime?
  notes       LeadNote[]
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Talebe ekip notu ya da durum değişikliği kaydı (kind: "not" | "durum")
model LeadNote {
  id        Int            @id @default(autoincrement())
  leadId    Int
  lead      ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String         @default("not")
  text      String
  author    String?
  createdAt DateTime       @default(now())

  @@index([leadId])
}
