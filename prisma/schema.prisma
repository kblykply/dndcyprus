generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  subject     String
  message     String
  // Reklam ölçümü ve kaynak takibi (20260915120000_lead_attribution)
  project     String?
  unitType    String?
  form        String?
  source      String?
  campaign    String?
  pageUrl     String?
  eventId     String?
  attribution Json?
  // Satış takibi (20261125180000_lead_status_notes): yeni | arandi | gorusuluyor | satis | olumsuz
  status      String     @default("yeni")
  statusAt    DateTime?
  notes       LeadNote[]
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([status])
}

/// Talebe ekip notu ya da durum değişikliği kaydı (kind: "not" | "durum")
model LeadNote {
  id        Int            @id @default(autoincrement())
  leadId    Int
  lead      ContactMessage @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String         @default("not")
  text      String
  author    String?
  createdAt DateTime       @default(now())

  @@index([leadId])
}

/// Clarity günlük birikimi (20261125200000_clarity_snapshots): day = Kıbrıs günü ya da "anlik"; dimension = URL | Device | Channel
model ClaritySnapshot {
  id        Int      @id @default(autoincrement())
  day       String
  dimension String
  data      Json
  fetchedAt DateTime @default(now())

  @@unique([day, dimension])
  @@index([day])
}

/// İçerik yönetimi: koddaki varsayılanın üstüne yazılan alan (20261126000000_content). value = düz yazı ya da **kalın** işaretli metin
model ContentOverride {
  id        Int      @id @default(autoincrement())
  scope     String
  locale    String
  path      String
  value     String
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?

  @@unique([scope, locale, path])
}

/// İçerik listeleri (collection: "basin" | "ekip"); data dile göre alanları ({ tr, en, de, ru, pl }) taşır
model ContentItem {
  id         Int      @id @default(autoincrement())
  collection String
  key        String
  data       Json
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  updatedBy  String?

  @@unique([collection, key])
  @@index([collection])
}

/// İçerik işlem geçmişi (kim, neyi, ne zaman)
model ContentLog {
  id        Int      @id @default(autoincrement())
  area      String
  action    String
  detail    String
  author    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
