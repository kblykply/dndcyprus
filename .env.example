# DND Cyprus — ortam değişkenleri örneği
# Bu dosya örnektir; gerçek değerler Vercel → Settings → Environment Variables içine girilir.
# NEXT_PUBLIC_ ile başlayanlar derlemeye gömülür → değiştirince yeniden deploy gerekir.
# Boş ya da biçimi hatalı bırakılan entegrasyon sessizce kapalı kalır, site bozulmaz.

# ---------- Google Analytics 4 ----------
# GA4 → Admin → Data streams → Measurement ID
NEXT_PUBLIC_GA4_ID=G-M944YNCLQ2

# ---------- Google Ads ----------
# Ads → Hedefler → Dönüşümler → dönüşüm → Etiketi kendiniz yükleyin →
# send_to: 'AW-123456789/AbCdEfGh'  →  "/" öncesi ID, sonrası etiket
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18454433145
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=qrAYCMTtzfkcEPma4d9E
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=YIJrCP3_yfkcEPma4d9E
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=8wYdCODOyvkcEPma4d9E

# ---------- Meta (Facebook / Instagram) ----------
# Events Manager → Veri kaynakları → Pixel → Kimlik (yalnızca rakam)
NEXT_PUBLIC_META_PIXEL_ID=688225483329810
# Pixel → Ayarlar → Dönüşümler API'si → Erişim anahtarı (GİZLİ, Vercel'de "Sensitive")
META_CAPI_TOKEN=
# developers.facebook.com/docs/graph-api/changelog → güncel sürüm, ör. v23.0
META_GRAPH_API_VERSION=
# Yalnızca test sırasında: Events Manager → Test olayları → sunucu test kodu
META_TEST_EVENT_CODE=

# ---------- Microsoft Clarity (ısı haritası, oturum kaydı) ----------
# clarity.microsoft.com → proje → Settings → Setup → proje kimliği (10 karakter civarı, harf+rakam)
# Yalnızca analitik izniyle yüklenir.
NEXT_PUBLIC_CLARITY_ID=yj9g0labqq

# ---------- İsteğe bağlı ----------
# Ek pazarlama etiketleri için GTM (GA4/Ads/Pixel'i GTM içinde TEKRAR kurmayın)
NEXT_PUBLIC_GTM_ID=
# Search Console'u DNS yerine meta etiketle doğrulamak isterseniz
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- Zaten tanımlı olanlar (Vercel'de mevcut, dokunmayın) ----------
# DATABASE_URL=
# ADMIN_USER=
# ADMIN_PASSWORD=
# Yönetici oturum imzası için önerilir: openssl rand -hex 32
ADMIN_SESSION_SECRET=
