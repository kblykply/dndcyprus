{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "dndcyprus.com"
        }
      ],
      "destination": "https://www.dndcyprus.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "dndcyprus-azure.vercel.app"
        }
      ],
      "destination": "https://www.dndcyprus.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/yedek",
      "schedule": "0 6 * * 1"
    }
  ]
}
